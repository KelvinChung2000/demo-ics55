FAB_MODELS_PACK='../../../Fabric/models_pack.v'
# ICS55 through ECC, not a ciel family, so FABulous takes the manual-setup path
# and never reaches for ~/.ciel. The value this was created with, ihp-sg13g2,
# named a PDK this fabric has never built on. The root is the `pdk` submodule
# Fabric/ecc_config.toml names, written absolute because FABulous resolves it
# against its working directory rather than the project.
FAB_PDK='ics55'
FAB_PDK_ROOT='/home/kelvin/side-project/demo-ics55/pdk'
